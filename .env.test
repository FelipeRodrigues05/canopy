# Loaded automatically by `bun test`. Points at docker-compose.test.yaml.
NODE_ENV=test
LOG_LEVEL=silent
APP_ROLES=api
DATABASE_URL=postgres://canopy_app:app@localhost:55432/canopy_test
MIGRATOR_DATABASE_URL=postgres://canopy_migrator:migrator@localhost:55432/canopy_test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:54566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAIT_TIME_SECONDS=1
SQS_VISIBILITY_TIMEOUT_SECONDS=5
# Short backoff so the pending-reference tests run in seconds (prod: 1s .. 5min, 10 attempts).
PENDING_REFERENCE_BASE_DELAY_MS=20
PENDING_REFERENCE_MAX_DELAY_MS=100
PENDING_REFERENCE_MAX_ATTEMPTS=4
