NODE_ENV=development
PORT=3000
APP_ROLES=api,consumer,workers
LOG_LEVEL=info

# App connects as canopy_app (DML only); migrations run as canopy_migrator (DDL).
DATABASE_URL=postgres://canopy_app:app@localhost:5432/canopy
MIGRATOR_DATABASE_URL=postgres://canopy_migrator:migrator@localhost:5432/canopy
DATABASE_POOL_MAX=10

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo

# Keycloak (docker compose). Tokens: see README "Authentication".
AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
AUTH_AUDIENCE=canopy-api
