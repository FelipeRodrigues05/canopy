{
  "name": "canopy",
  "version": "0.0.1",
  "description": "Canopy: distributed wagering processor (NestJS + Bun + PostgreSQL + SQS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/ scripts/ && bun scripts/check-architecture.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun test src",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:infra:up": "docker compose -f docker-compose.test.yaml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yaml down -v",
    "test:integration": "bun run test:infra:prepare && bun test --timeout 90000 --max-concurrency 1 test/integration",
    "test:concurrency": "bun run test:infra:prepare && bun test --timeout 180000 test/concurrency",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:status": "bun scripts/migrate.ts status",
    "migration:create": "bun scripts/migrate.ts create",
    "deps:wait": "bun scripts/wait-for-deps.ts",
    "test:load": "bun scripts/load/run.ts",
    "test:infra:prepare": "bun run test:infra:up && NODE_ENV=test bun scripts/wait-for-deps.ts && NODE_ENV=test bun scripts/migrate.ts up"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
